# WordPress surface environment (AFC-1209).
#
# NAMES ONLY. Every value below is deliberately empty. A real value in this
# file is a secret committed to a repository that will hold children's
# records.
#
# Real values live in `services/wp/.env` on the VPS host (mode 600,
# git-ignored) or are injected at deploy time. Never paste one into an issue,
# a comment, a document or a commit message. Never commit `.env`.

# --- Database ---------------------------------------------------------------
WP_DB_NAME=
WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=

# --- Table prefix -------------------------------------------------------------
WP_TABLE_PREFIX=

# --- Portal integration (server-side only) ------------------------------------
# Staging portal endpoint the theme handler POSTs to, e.g.
# https://afc-staging.bluespace.ng/api/register
# Empty = registration closed (fail-closed notice, no open door).
AFC_PORTAL_REGISTER_URL=

# --- Registration open/close flag ----------------------------------------------
# "open" serves the form; anything else serves the closed notice.
AFC_YSTC_REGISTRATION_OPEN=
