# AFC Church Portal — staging Caddyfile snippet (AFC-386).
#
# Web only. No postgres, no Directus blocks yet — they arrive with the backend
# cutover and follow docs/planning/infra-spec.md §4.
#
# Staging domain is afc-staging.bluespace.ng (board decision, AFC-383).
# NOTE (AFC-561): the http:// prefix below is load-bearing, not stylistic. TLS
# terminates at Cloudflare (Flexible mode); origin has never held a certificate.
# A bare domain enables Caddy automatic-HTTPS and its port-80 redirect loops
# back through Cloudflare (outage 2026-10-20). Do not remove the prefix
# without terminating TLS at origin first.
# To change it again: replace the site address on line 10 with the new domain.

http://afc-staging.bluespace.ng {
	encode gzip

	# AFC-1217: shared-store edge rate limit for the public registration
	# proxy (ADR adr-wp-build, data-model §9, PRD §7.6). This single Caddy
	# is the only ingress, so a zone here is shared across all web
	# replicas/workers — a per-instance in-memory limiter is explicitly
	# rejected (the limit that appears to exist is not the limit that
	# applies). Enabled via the custom build in Dockerfile.caddy
	# (Caddy 2.10.0 + pinned github.com/mholt/caddy-ratelimit — stock
	# caddy:2-alpine has no `rate_limit` directive and breaks on this
	# block). Shape follows infra-spec §4.
	#
	rate_limit {
		zone register {
			match {
				method POST
				path /api/register
			}
			# Per-client-IP bucket (contract doc §5: 20 events/min/client
			# IP). The module defaults an empty key to ONE global bucket —
			# without this line open day is capped at 20 registrations/min
			# TOTAL. One-line deviation from the AFC-1210 commented shape,
			# stated, not silent. Cloudflare caveat: TLS terminates at the
			# edge (AFC-561), so true per-client partitioning needs
			# trusted_proxies/XFF handling — CTO follow-up, not this zone.
			key {remote_host}
			window 1m
			events 20
		}
	}
	# Abuse expectation (open-day path): 20 POST /api/register per
	# minute per client IP, excess answered 429 with Retry-After; see
	# docs/planning/wp-portal-registration-contract.md §abuse-protection
	# for the k6 script the CTO runs on staging before open.

	reverse_proxy web:3000 {
		# Zero-downtime staging deploys: hold requests (including
		# replays) while the replacement container boots instead of
		# answering 502. Kiosk check-in is idempotent server-side, so
		# a replayed POST cannot double-apply (AFC-987).
		lb_try_duration 60s
		lb_try_interval 250ms
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Directus admin/API (afc-staging-api.bluespace.ng). Added 2026-10-21: NPM
# already routes this hostname at CT105:80, but Caddy had no site block for it.
# Same http:// pattern as above (TLS at Cloudflare Flexible; see AFC-561).
# NOTE: exposing Directus publicly was gated on CTO sign-off in
# compose.directus.yml (least-privilege comment) — this block enacts that
# approval for staging. Directus itself stays loopback-only (127.0.0.1:8055);
# external traffic enters only through this reverse proxy.

http://afc-staging-api.bluespace.ng {
	encode gzip

	reverse_proxy directus:8055

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
