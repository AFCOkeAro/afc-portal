# Staging service environment (AFC-385).
#
# NAMES ONLY. Every value below is deliberately empty. A real value in this
# file is a secret committed to a repository that will hold children's
# records.
#
# Real values live in `services/staging/.env` on the VPS host (mode 600,
# git-ignored) or are injected at deploy time. Never paste one into an issue,
# a comment, a document or a commit message. Never commit `.env`.

# --- Image ------------------------------------------------------------------
# Tag built by CI (AFC-384) or `docker build -f apps/web/Dockerfile .`.
# Rollback = redeploy the previous tag: set WEB_IMAGE to the last good tag
# and re-run the start command in README.md. No database exists in this
# bundle, so there is nothing to migrate back.
WEB_IMAGE=

# --- Auth -------------------------------------------------------------------
# Staging serves the real auth path: stub identities OFF. The app refuses to
# serve them from a production build in any case (NODE_ENV=production), so
# `true` here would only break sign-in, never open a back door — but leave it
# `false`.
NUXT_STUB_AUTH=false

# Seals the portal session cookie. REQUIRED: with it empty, session routes
# answer 503 (`NUXT_SESSION_SECRET is not configured`). Generate on the host,
# e.g. `openssl rand -base64 48`, and store only in the host `.env`.
NUXT_SESSION_SECRET=

# --- Directus (not deployed yet — leave all four empty) ----------------------
# Empty is the supported staging state: GET /api/health answers 200 with
# `directusConfigured:false`; sign-in and public registration answer 503
# saying Directus is not deployed. Do not point these at production, and do
# not use youth or production data to "test" staging.
NUXT_DIRECTUS_URL=
NUXT_PUBLIC_DIRECTUS_URL=
NUXT_DIRECTUS_SERVER_TOKEN=
NUXT_DIRECTUS_PUBLIC_TOKEN=

# --- Directus overlay (services/staging/compose.directus.yml) --------------------
# Staging-only Postgres 16 + directus/directus:11 preview login. Internal
# http://directus:8055, local uploads volume. All values live only in the
# host `.env` (mode 600). Generate secrets on the host, e.g.
# `openssl rand -base64 48`, and never commit real values.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_PUBLIC_URL=

# --- Bind -------------------------------------------------------------------
# Fixed by compose.yml (NITRO_HOST 0.0.0.0, NITRO_PORT 3000). No variables.
