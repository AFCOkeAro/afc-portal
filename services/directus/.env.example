# Directus service environment.
#
# NAMES ONLY. Every value below is deliberately empty (repo-plan §6, infra-spec
# §5). A real value in this file is a secret committed to a repository that will
# hold children's records, and `.gitignore` only protects `.env`, not the mistake
# of writing a value into the example.
#
# Real values live in `services/directus/.env` on the host (mode 600) or are
# injected at deploy time from the GitHub Actions environments. Never paste one
# into an issue, a comment, a document or a commit message — propose it through
# the Paperclip secret flow instead.

# --- DEPLOY REGION — the Q21 region pin -------------------------------------
#
# REQUIRED. NO DEFAULT. This is the one variable here that has no correct value
# until a human chooses it, and it is deliberately left empty rather than given a
# placeholder: a placeholder is a default, and the entire point is that this
# deployment does not inherit one by accident.
#
# No other document may name a region on its own. Every document refers to this
# variable instead. ADR "Pin the production hosting region" (AFC-171).
#
# Format:  <ISO-3166-1 alpha-2 country code> ":" <provider location code>
#   XX:yyyy    country code, then the provider's location identifier for that site
#
# `XX` and `yyyy` are not real codes. Do not provision with them; they show the
# shape and cannot be mistaken for a decision. Order matters and does not
# invert. The country half is what the NDPA processor register and counsel need;
# the location half is what the provider's provisioning API expects.
#
# Chosen once, by a human with authority to spend, at the moment the production
# VPS is bought, and recorded here. It is unset today because the board rejected
# both procurement approvals on 2026-10-06 and nothing is funded. That is a
# funding state, not a decision, and it must not be filled in to make a warning
# go away.
DEPLOY_REGION=

# --- Database ---------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Directus ---------------------------------------------------------------
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
DIRECTUS_PUBLIC_URL=

# --- Frontend ---------------------------------------------------------------
SITE_URL=
NUXT_PUBLIC_DIRECTUS_URL=

# Server-side scoped token for SSR reads.
NUXT_DIRECTUS_SERVER_TOKEN=
# NOT in infra-spec section 5's table. Added with AFC-174 for the public
# registration proxy, which needs a token whose Directus policy is the *public*
# role's rather than the application's. Needs CTO ratification; see the AFC-174
# update.
NUXT_DIRECTUS_PUBLIC_TOKEN=
# Seals the portal session cookie. No default; the app refuses to start a
# session without it.
NUXT_SESSION_SECRET=

# --- Transactional email ----------------------------------------------------
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# --- Backup and media object storage ---------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Observability (optional) -----------------------------------------------
SENTRY_DSN=
UPTIME_CHECK_URL=

# --- Local development only -------------------------------------------------
# Enables the seeded stub identities in apps/web/server/utils/stub-identities.ts.
# The app refuses to serve them when NODE_ENV is production. Never set this in
# staging or production.
NUXT_STUB_AUTH=