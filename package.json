{
  "name": "afc-church-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gate:awareness": "bash scripts/awareness-write-context-gate.sh",
    "gate:retention": "bash scripts/retention-literal-gate.sh",
    "gate:migration-privilege": "bash scripts/migration-privilege-gate.sh",
    "gate:self-test": "bash scripts/awareness-write-context-gate.sh --self-test && bash scripts/retention-literal-gate.sh --self-test && bash scripts/migration-privilege-gate.sh --self-test && node scripts/run-db-tests.mjs --self-test",
    "test:db": "node scripts/run-db-tests.mjs",
    "test": "pnpm gate:self-test && pnpm gate:awareness && pnpm gate:retention && pnpm gate:migration-privilege && pnpm test:db",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter @afc/shared typecheck && pnpm --filter web typecheck",
    "lint": "pnpm --filter web lint",
    "lint:fix": "pnpm --filter web lint:fix",
    "format": "prettier --write apps packages package.json .github",
    "format:check": "prettier --check apps packages package.json .github"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "pg": "8.23.1",
    "prettier": "^3.9.9"
  },
  "packageManager": "pnpm@10.33.0"
}
