# No trailing slash: pnpm links this as a SYMLINK to the store, and
# "node_modules/" does not match a symlink. It leaked into the first
# commit attempt in this workspace.
node_modules
.pnpm-store/
dist/
.nuxt/
.output/
.next/
.turbo/
coverage/
*.tsbuildinfo

# Secrets: never commit. .env.example is the only env file that is tracked.
.env
.env.*
!.env.example

# Local Directus / Postgres runtime state
services/directus/uploads/
services/directus/backup/*.dump
services/directus/backup/*.tar
services/directus/backup/*.sql.gz
.pglite/

.DS_Store
*.log
# Stale per-run debug copies of scripts/run-db-tests.mjs
scripts/.dbg*.mjs
scripts/_dbg.mjs
scripts/_diag.mjs

# Scratch written into the repo ROOT instead of PAPERCLIP_RUN_SCRATCH_DIR.
# 130 KB of it was once sitting here untracked (an issue JSON dump, a markdown
# dump, two PGlite probe scripts) and untracked scratch in the root is one
# `git add -A` away from a commit. Untracked is not the same as absent.
# Use PAPERCLIP_RUN_SCRATCH_DIR; it is removed for you at end of run.
/cto-*-tmp.mjs
/cto-*-tmp.js
/cto-verify*.mjs
/afc*.json
/afc*.md
# The shape of the defect, not one instance of it: a scratch script in the
# repo root. No legitimate tracked file lives at the root with this suffix.
/*-tmp.mjs
/*-tmp.js
